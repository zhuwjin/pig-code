{
  "apiVersion": 1,
  "id": "com.pigcodets.plugins.moon",
  "name": {
    "zh-CN": "月亮界面",
    "en": "Moon UI"
  },
  "version": "1.1.0",
  "build": 2,
  "uiEntry": "App.tsx",
  "componentEntry": "component.tsx",
  "backend": "backend.ts",
  "minHostVersion": "1.0.0",
  "protocols": {
    "ui": 1,
    "services": 1
  },
  "capabilities": [
    {
      "name": "ui.add",
      "targets": ["status", "composer", "settings", "workspace"]
    },
    {
      "name": "tools.provide",
      "targets": ["MoonEcho"]
    },
    {
      "name": "session.read",
      "targets": ["*"]
    },
    {
      "name": "navigation.open",
      "targets": ["main"]
    },
    {
      "name": "composer.submit",
      "targets": ["*"]
    }
  ],
  "contributions": {
    "api_version": 1,
    "description": {
      "zh-CN": "演示声明式槽位、页面和 Surface 弹层",
      "en": "Demonstrates declarative slots, pages and Surface overlays"
    },
    "pages": [
      {
        "id": "moon-page",
        "surface": "MoonPage",
        "title": { "en": "Moon", "zh-CN": "月亮" },
        "kind": "workspace",
        "icon": "moon",
        "order": 10
      },
      {
        "id": "moon-settings",
        "surface": "MoonSettings",
        "title": { "en": "Moon", "zh-CN": "月亮" },
        "kind": "settings",
        "icon": "moon",
        "order": 10
      }
    ],
    "ui": [
      {
        "id": "moon-metric",
        "slot": "status",
        "kind": "metric",
        "label": { "en": "Moon", "zh-CN": "月亮" },
        "icon": "moon",
        "order": 0
      },
      {
        "id": "moon-popover",
        "slot": "status",
        "kind": "popover",
        "label": { "en": "Moon details", "zh-CN": "月亮详情" },
        "icon": "activity",
        "surface": "MoonPopover",
        "width": 320,
        "height": 240,
        "order": 10
      },
      {
        "id": "moon-action",
        "slot": "composer",
        "kind": "button",
        "label": { "en": "Submit with Moon", "zh-CN": "通过月亮提交" },
        "icon": "moon",
        "order": 10
      }
    ],
    "tools": [
      {
        "name": "MoonEcho",
        "description": "Returns the supplied text through the plugin backend",
        "parameters": {
          "type": "object",
          "properties": {
            "text": { "type": "string" }
          },
          "required": ["text"]
        },
        "read_only": true,
        "availability": "static"
      }
    ],
    "themes": [
      {
        "id": "moon",
        "entry": "moon-theme.json"
      },
      {
        "id": "moon-glass",
        "entry": "moon-glass.json"
      }
    ],
    "skills": [
      {
        "path": "skills/moon"
      }
    ],
    "config": {
      "items": [
        {
          "key": "greeting",
          "description": {
            "en": "Greeting displayed by the moon plugin"
          },
          "default": "Hello moon"
        }
      ],
      "read": [],
      "write": []
    },
    "actions": ["provide_themes", "provide_tools", "read_config"]
  }
}
