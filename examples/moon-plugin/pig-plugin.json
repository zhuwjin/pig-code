{
  "apiVersion": 1,
  "id": "com.pigcodets.plugins.moon",
  "name": {
    "zh-CN": "月亮 Agent",
    "en": "Moon Agent"
  },
  "version": "2.0.0",
  "build": 3,
  "backend": "backend.ts",
  "minHostVersion": "1.0.0",
  "protocols": {
    "ui": 1,
    "services": 1
  },
  "capabilities": [
    {
      "name": "tools.provide",
      "targets": [
        "MoonEcho"
      ]
    },
    {
      "name": "navigation.open",
      "targets": [
        "main"
      ]
    }
  ],
  "contributions": {
    "api_version": 1,
    "description": {
      "zh-CN": "演示 Agent 工具、命令、主题和 Skill",
      "en": "Demonstrates an Agent tool, command, themes and a Skill"
    },
    "tools": [
      {
        "name": "MoonEcho",
        "description": "Returns the supplied text through the plugin backend",
        "parameters": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "read_only": true,
        "availability": "static"
      }
    ],
    "commands": [
      {
        "id": "moon-workspace",
        "title": {
          "en": "Open workspace with Moon",
          "zh-CN": "通过月亮打开工作区"
        },
        "export": "openWorkspace",
        "order": 10
      }
    ],
    "themes": [
      {
        "id": "moon",
        "entry": "moon-theme.json"
      },
      {
        "id": "moon-glass",
        "entry": "moon-glass.json"
      }
    ],
    "skills": [
      {
        "path": "skills/moon"
      }
    ],
    "config": {
      "items": [
        {
          "key": "greeting",
          "description": {
            "en": "Greeting displayed by the moon plugin"
          },
          "default": "Hello moon",
          "schema": {
            "type": "string",
            "maxLength": 80
          }
        }
      ],
      "read": [],
      "write": []
    },
    "actions": [
      "provide_themes",
      "provide_tools",
      "provide_providers",
      "read_config",
      "write_config"
    ]
  }
}
